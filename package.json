{
  "name": "lockd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "start:server": "next start --hostname 0.0.0.0 --port ${PORT:-3100}",
    "start:staging": "npm run staging:release && npm run start:server",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "db:local": "tsx scripts/local-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "worker": "tsx scripts/worker.ts",
    "billing:local": "tsx scripts/local-billing.ts",
    "staff:local": "tsx scripts/local-staff.ts",
    "staging:release": "tsx scripts/staging-release.ts",
    "staging:smoke": "tsx scripts/staging-smoke.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
