# Local setup generates .env.local; never use production credentials locally.
DATABASE_URL=postgresql://lockd_runtime:REPLACE@127.0.0.1:55432/lockd
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@127.0.0.1:55432/lockd
APP_ORIGIN=http://127.0.0.1:3100
LOCKD_LOCAL_ONLY=1
# Local mailbox is visible only on loopback in explicit local mode.
# No SMTP, payment provider or live bank account configured.
