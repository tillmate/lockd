# Local setup generates .env.local; never use production credentials locally.
DATABASE_URL=postgresql://lockd_runtime:REPLACE@127.0.0.1:55432/lockd
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@127.0.0.1:55432/lockd
# Worker-only role: claims, renders and records delivery of queued email. No booking access.
NOTIFIER_DATABASE_URL=postgresql://lockd_notifier:REPLACE@127.0.0.1:55432/lockd
APP_ORIGIN=http://127.0.0.1:3100
LOCKD_LOCAL_ONLY=1
# db:local generates private 32-byte hex keys. Configure separately outside local development.
# STAFF_MFA_KEY encrypts staff authenticator secrets.
# NOTIFICATION_KEY encrypts one-time links while their email is queued (web app and worker).
STAFF_MFA_KEY=REPLACE_WITH_64_HEX
NOTIFICATION_KEY=REPLACE_WITH_64_HEX

# Email delivery (worker). local = write to the ignored test mailbox only (loopback local mode).
# resend = real delivery via https://resend.com; requires an https APP_ORIGIN and a verified domain.
# Unset/disabled = messages stay queued; nothing is lost.
EMAIL_PROVIDER=local
# RESEND_API_KEY=re_...
# EMAIL_FROM=Lockd <bookings@your-verified-domain>
# EMAIL_REPLY_TO=support@your-verified-domain
# Staging safety: only deliver to these recipient domains; everything else is suppressed and audited.
# EMAIL_ALLOWED_DOMAINS=usetillmate.com
# WORKER_HEALTH_PORT=3101
